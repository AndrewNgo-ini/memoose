{
  "name": "mnemoth",
  "displayName": "mnemoth",
  "version": "0.2.0",
  "description": "Persistent project memory for coding agents: cognee-style typed knowledge graph exposed as MCP tools and a skill. No API key.",
  "author": {
    "name": "Hieu Ngo"
  },
  "license": "Apache-2.0",
  "keywords": [
    "memory",
    "knowledge-graph",
    "mcp",
    "skill"
  ],
  "mcpServers": {
    "mnemoth": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "mnemoth",
        "serve"
      ],
      "env": {
        "MNEMOTH_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
